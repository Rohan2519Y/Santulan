generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (minimal stand-in for the "existing users module" referenced by
// research.md §7 - not part of this feature's scope, kept intentionally thin)
// ---------------------------------------------------------------------------

enum UserRole {
  participant
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  participantProfile   ParticipantProfile?
  importsCreated       ContentImportRecord[] @relation("ImportedBy")
  qualityFlagsReviewed QualityFlag[]         @relation("ReviewedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Instrument
// ---------------------------------------------------------------------------

enum LifecycleStatus {
  DRAFT
  FROZEN
  RETIRED
}

model ResponseScale {
  id               String          @id @default(uuid())
  version          String          @unique
  scalePoints      Int             @map("scale_points")
  anchorLabels     Json            @map("anchor_labels")
  keyingDefinition Json            @map("keying_definition")
  frozenAt         DateTime?       @map("frozen_at")
  status           LifecycleStatus @default(DRAFT)

  assessmentVersions AssessmentVersion[]

  @@map("response_scales")
}

enum ToolBand {
  ADOLESCENT
  EMERGING_ADULT
}

model AssessmentVersion {
  id              String          @id @default(uuid())
  versionLabel    String          @unique @map("version_label")
  responseScaleId String          @map("response_scale_id")
  responseScale   ResponseScale   @relation(fields: [responseScaleId], references: [id])
  toolBand        ToolBand        @map("tool_band")
  sourceFile      String          @map("source_file")
  contentHash     String          @map("content_hash")
  frozenAt        DateTime?       @map("frozen_at")
  status          LifecycleStatus @default(DRAFT)
  isActive        Boolean         @default(false) @map("is_active")

  items               Item[]
  attempts            AssessmentAttempt[]
  interpretationRules InterpretationRule[]

  @@unique([isActive], map: "assessment_versions_one_active", where: raw("is_active = true"))
  @@map("assessment_versions")
}

enum ItemKeying {
  POSITIVE
  REVERSE
}

enum ItemLayer {
  CORE
  V
  SJT
  O
}

enum ItemStatus {
  ACTIVE
  RETIRED
}

model Item {
  id                  String            @id @default(uuid())
  assessmentVersionId String            @map("assessment_version_id")
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  itemCode            String            @map("item_code")
  domainCode          String            @map("domain_code")
  subdomainCode       String            @map("subdomain_code")
  domainName          String            @map("domain_name")
  subdomainName       String            @map("subdomain_name")
  itemText            String            @map("item_text")
  keying              ItemKeying
  ageBand             String            @map("age_band")
  context             String
  layer               ItemLayer         @default(CORE)
  status              ItemStatus        @default(ACTIVE)
  displayOrder        Int               @map("display_order")

  responses      Response[]
  responseEvents ResponseEvent[]

  @@unique([itemCode, assessmentVersionId], map: "items_code_per_version")
  @@map("items")
}

// ---------------------------------------------------------------------------
// Participant
// ---------------------------------------------------------------------------

enum ParticipationRoute {
  OPEN
  INSTITUTIONAL
}

enum AgeBand {
  D1
  D2
  D3
  D4
}

enum ParticipantContext {
  SCHOOL
  COLLEGE_WORK
  GENERAL
}

model ParticipantProfile {
  id                     String             @id @default(uuid())
  userId                 String             @unique @map("user_id")
  user                   User               @relation(fields: [userId], references: [id])
  santulanId             String             @unique @map("santulan_id")
  participationRoute     ParticipationRoute @map("participation_route")
  ageBand                AgeBand            @map("age_band")
  isMinor                Boolean            @map("is_minor")
  context                ParticipantContext
  administrationLanguage String             @default("en") @map("administration_language")

  consents  Consent[]
  attempts  AssessmentAttempt[]
  responses Response[]
  scores    ScoreResult[]
  reports   Report[]

  @@map("participant_profiles")
}

enum ConsentType {
  ADULT_SELF_CONSENT
  PARENT_GUARDIAN_CONSENT
  STUDENT_ASSENT
}

enum ConsentStatus {
  PENDING
  GRANTED
  VERIFIED
  WITHDRAWN
}

model Consent {
  id                   String             @id @default(uuid())
  participantProfileId String             @map("participant_profile_id")
  participantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id])
  consentType          ConsentType        @map("consent_type")
  protocolVersion      String             @map("protocol_version")
  verificationMethod   String?            @map("verification_method")
  verifiedAt           DateTime?          @map("verified_at")
  status               ConsentStatus      @default(PENDING)
  createdAt            DateTime           @default(now()) @map("created_at")

  @@map("consents")
}

// ---------------------------------------------------------------------------
// Attempt / Response
// ---------------------------------------------------------------------------

enum AttemptStatus {
  CREATED
  STARTED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  SCORING
  SCORED
  REPORT_READY
  QUALITY_HOLD
  INVALID
  EXPIRED
}

model AssessmentAttempt {
  id                  String            @id @default(uuid())
  participantProfileId String           @map("participant_profile_id")
  participantProfile  ParticipantProfile @relation(fields: [participantProfileId], references: [id])
  assessmentVersionId String            @map("assessment_version_id")
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  scoringVersion      String            @map("scoring_version")
  status              AttemptStatus     @default(CREATED)
  sessionCount        Int               @default(0) @map("session_count")
  startedAt           DateTime?         @map("started_at")
  submittedAt         DateTime?         @map("submitted_at")
  completedAt         DateTime?         @map("completed_at")
  idempotencyKey      String            @unique @map("idempotency_key")
  createdAt           DateTime          @default(now()) @map("created_at")

  responses      Response[]
  responseEvents ResponseEvent[]
  qualityFlags   QualityFlag[]
  scoreResults   ScoreResult[]
  report         Report?

  @@unique([participantProfileId, assessmentVersionId], map: "attempts_one_active_per_participant_version", where: raw("status IN ('CREATED','STARTED','IN_PROGRESS','PAUSED')"))
  @@map("assessment_attempts")
}

model Response {
  id                    String             @id @default(uuid())
  attemptId             String             @map("attempt_id")
  attempt               AssessmentAttempt  @relation(fields: [attemptId], references: [id])
  itemId                String             @map("item_id")
  item                  Item               @relation(fields: [itemId], references: [id])
  participantProfileId  String             @map("participant_profile_id")
  participantProfile    ParticipantProfile @relation(fields: [participantProfileId], references: [id])
  responseValue         Int                @map("response_value")
  responseVersion       Int                @map("response_version")
  isCurrent             Boolean            @default(true) @map("is_current")
  supersedesResponseId  String?            @map("supersedes_response_id")
  supersedesResponse    Response?          @relation("ResponseChain", fields: [supersedesResponseId], references: [id])
  supersededBy          Response[]         @relation("ResponseChain")
  responseTimeMs        Int?               @map("response_time_ms")
  answeredAt            DateTime           @map("answered_at")
  idempotencyKey        String             @unique @map("idempotency_key")

  @@unique([attemptId, itemId], map: "responses_one_current_per_attempt_item", where: raw("is_current = true"))
  @@map("responses")
}

enum ResponseEventType {
  SESSION_START
  SESSION_END
  PAUSE
  RESUME
  RESPONSE_SAVED
  SUBMIT
}

model ResponseEvent {
  id            String            @id @default(uuid())
  attemptId     String            @map("attempt_id")
  attempt       AssessmentAttempt @relation(fields: [attemptId], references: [id])
  itemId        String?           @map("item_id")
  item          Item?             @relation(fields: [itemId], references: [id])
  eventType     ResponseEventType @map("event_type")
  sessionNumber Int               @map("session_number")
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  metadata      Json?

  @@map("response_events")
}

enum QualityFlagCode {
  Q01
  Q02
  Q03
  Q04
  Q05
  Q06
  Q07
  Q08
  Q09
}

model QualityFlag {
  id           String            @id @default(uuid())
  attemptId    String            @map("attempt_id")
  attempt      AssessmentAttempt @relation(fields: [attemptId], references: [id])
  domainCode   String?           @map("domain_code")
  flagCode     QualityFlagCode   @map("flag_code")
  severity     String
  detectedAt   DateTime          @default(now()) @map("detected_at")
  disposition  String?
  reviewedById String?           @map("reviewed_by")
  reviewedBy   User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?         @map("reviewed_at")

  @@map("quality_flags")
}

enum ScoreStatus {
  S0
  S1
  S2
  S3
  S4
  S5
  SH
}

model ScoreResult {
  id                   String             @id @default(uuid())
  attemptId            String             @map("attempt_id")
  attempt              AssessmentAttempt  @relation(fields: [attemptId], references: [id])
  participantProfileId String             @map("participant_profile_id")
  participantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id])
  domainCode           String             @map("domain_code")
  rawScore             Decimal            @map("raw_score") @db.Decimal(3, 2)
  validResponseCount   Int                @map("valid_response_count")
  eligibleItemCount    Int                @map("eligible_item_count")
  completenessRate     Decimal            @map("completeness_rate") @db.Decimal(4, 3)
  scoreStatus          ScoreStatus        @map("score_status")
  scoringVersion       String             @map("scoring_version")
  calculatedAt         DateTime           @default(now()) @map("calculated_at")

  @@unique([attemptId, domainCode], map: "score_results_one_per_attempt_domain")
  @@map("score_results")
}

model InterpretationRule {
  id                    String            @id @default(uuid())
  assessmentVersionId   String            @map("assessment_version_id")
  assessmentVersion     AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  domainCode            String            @map("domain_code")
  developmentalBand     String            @map("developmental_band")
  evidenceState         String            @map("evidence_state")
  locale                String            @default("en")
  ruleCode              String            @map("rule_code")
  approvedTextTemplate  String            @map("approved_text_template")
  version               String
  status                LifecycleStatus   @default(FROZEN)

  @@unique([assessmentVersionId, domainCode, developmentalBand, evidenceState, locale], map: "interpretation_rules_unique_lookup")
  @@map("interpretation_rules")
}

enum ReportGenerationStatus {
  PENDING
  REPORT_READY
  FAILED_RETRYABLE
}

model Report {
  id                   String                 @id @default(uuid())
  attemptId            String                 @unique @map("attempt_id")
  attempt              AssessmentAttempt      @relation(fields: [attemptId], references: [id])
  participantProfileId String                 @map("participant_profile_id")
  participantProfile   ParticipantProfile     @relation(fields: [participantProfileId], references: [id])
  reportVersion        String                 @map("report_version")
  generationStatus     ReportGenerationStatus @default(PENDING) @map("generation_status")
  generatedAt          DateTime?              @map("generated_at")
  retryCount           Int                    @default(0) @map("retry_count")

  sections ReportSection[]

  @@map("reports")
}

enum ReportSectionType {
  T01_DOMAIN_RESULT
  T02_DESCRIPTIVE_SUMMARY
  T03_STRENGTHS
  T04_GROWTH_AREAS
  T05_PRIORITIES
  T06_ACTIONS
  T07_GROWTH_PLAN
  T08_PATHWAY
  T09_QUALITY_NOTE
  T10_ADMIN_ONLY
  T11_HOLD_NEUTRAL
  T12_NOT_ELIGIBLE
}

model ReportSection {
  id                       String            @id @default(uuid())
  reportId                 String            @map("report_id")
  report                   Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sectionType              ReportSectionType @map("section_type")
  domainCode               String?           @map("domain_code")
  contentVersion           String            @map("content_version")
  displayOrder             Int               @map("display_order")
  contentSnapshot          Json              @map("content_snapshot")
  isReleasedToParticipant  Boolean           @default(false) @map("is_released_to_participant")

  @@map("report_sections")
}

enum ImportStatus {
  accepted
  rejected
}

model ContentImportRecord {
  id           String       @id @default(uuid())
  filename     String
  versionLabel String       @map("version_label")
  importedById String       @map("imported_by")
  importedBy   User         @relation("ImportedBy", fields: [importedById], references: [id])
  status       ImportStatus
  errorSummary String?      @map("error_summary")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("content_import_records")
}

// ---------------------------------------------------------------------------
// Participation control (admin pause/stop/reopen, FR-013)
// ---------------------------------------------------------------------------

enum ParticipationAction {
  PAUSE
  STOP
  REOPEN
}

model ParticipationControl {
  id        String              @id @default(uuid())
  action    ParticipationAction
  reason    String?
  actorId   String              @map("actor_id")
  createdAt DateTime            @default(now()) @map("created_at")

  @@map("participation_controls")
}
