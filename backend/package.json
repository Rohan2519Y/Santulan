{
  "name": "santulan-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Santulan backend modular monolith - capability assessment module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "db:migrate": "node scripts/migrate.js && node scripts/santulan-grant-roles.js",
    "db:seed:dev": "node seeders/santulan/dev.seeder.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:grant:santulan": "node scripts/santulan-grant-roles.js",
    "db:generate:seed": "node scripts/santulan-generate-seed-sql.js",
    "catalog:generate": "node scripts/catalog-generate-csv.js",
    "catalog:verify": "node scripts/catalog-offline-verify.js",
    "catalog:reconcile": "node scripts/catalog-reconcile.js",
    "test:santulan": "jest --runInBand tests/santulan"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "uuid": "^9.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 20000
  }
}
