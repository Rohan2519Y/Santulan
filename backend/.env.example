DATABASE_URL="postgresql://postgres:1234@localhost:5432/santulandb?schema=public"
# Non-superuser role the running app connects as (T053): superusers always
# bypass row-level security regardless of FORCE ROW LEVEL SECURITY, so
# migrations run as DATABASE_URL's owner role but the app must use this one.
RUNTIME_DATABASE_URL="postgresql://app_runtime:app_runtime_dev_password@localhost:5432/santulandb?schema=public"
JWT_SECRET="change-me-in-production"
APP_PORT=8000
APP_ENV=development
# Comma-separated browser origins allowed to call this API (CORS). The CRA
# frontend dev server defaults to http://localhost:3000.
CORS_ORIGINS="http://localhost:3000"

# --- SanTulan 2.0 canonical API (specs/005-v3-1-canonical-alignment) ---
# Session token lifetime.
JWT_EXPIRES_IN=2h
# Shared key for worker / verifier endpoints (x-internal-api-key). Required for /consents/{id}/verify by a service and
# /internal/*; leave empty to disable service access (a SUPER_ADMIN token still works). Use a long random value.
INTERNAL_API_KEY=
# Identity adapter. "dev" keeps OTP in memory and bcrypt credentials in schema dev_identity (never in production).
IDENTITY_PROVIDER=dev
# Governed configuration files (absent or empty = the feature fails closed; no placeholder legal text ships).
CONSENT_PROTOCOLS_PATH=
QUALITY_POLICY_PATH=
EVIDENCE_CONFIG_PATH=
# Directory for research export files.
EXPORT_DIR=
# Server inactivity timeout for assessment sessions. UNSET = disabled (the duration is an unfrozen decision).
SESSION_INACTIVITY_MINUTES=
# Registration throttling per IP and per device cookie (separate from OTP limits).
REGISTRATION_THROTTLE_WINDOW_SECONDS=3600
REGISTRATION_THROTTLE_MAX_PER_IP=20
REGISTRATION_THROTTLE_MAX_PER_DEVICE=10
# Governed scoring version label stamped on score rows (ASSUMED default; change only through governance).
SCORING_VERSION=domain-mean-v1
# "on" starts the worker that quality-checks and scores SUBMITTED attempts; anything else leaves it off.
SCORING_PIPELINE=
