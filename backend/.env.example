DATABASE_URL="postgresql://postgres:1234@localhost:5432/santulandb?schema=public"
# Non-superuser role the running app connects as (T053): superusers always
# bypass row-level security regardless of FORCE ROW LEVEL SECURITY, so
# migrations run as DATABASE_URL's owner role but the app must use this one.
RUNTIME_DATABASE_URL="postgresql://app_runtime:app_runtime_dev_password@localhost:5432/santulandb?schema=public"
JWT_SECRET="change-me-in-production"
APP_PORT=8000
APP_ENV=development
# Comma-separated browser origins allowed to call this API (CORS). The CRA
# frontend dev server defaults to http://localhost:3000.
CORS_ORIGINS="http://localhost:3000"

# Platform-scope connection (bypasses row-level security). Used only for the login lookup,
# which runs before a school is known. Created by docker/init-app-role.sql.
PLATFORM_DATABASE_URL="postgresql://app_platform:app_platform_dev_password@localhost:5432/santulandb?schema=public"
