DATABASE_URL="postgresql://santulan:santulan_dev_password@localhost:5433/santulan_assessment?schema=public"
# Non-superuser role the running app connects as (T053): superusers always
# bypass row-level security regardless of FORCE ROW LEVEL SECURITY, so
# migrations run as DATABASE_URL's owner role but the app must use this one.
RUNTIME_DATABASE_URL="postgresql://app_runtime:app_runtime_dev_password@localhost:5433/santulan_assessment?schema=public"
JWT_SECRET="change-me-in-production"
APP_PORT=8000
APP_ENV=development
