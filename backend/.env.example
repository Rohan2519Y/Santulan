JWT_SECRET="change-me-in-production"
APP_PORT=8000
APP_ENV=development
# Comma-separated browser origins allowed to call this API (CORS). The CRA
# frontend dev server defaults to http://localhost:3000.
CORS_ORIGINS="http://localhost:3000"

# --- SanTulan 2.0 canonical API (specs/005-v3-1-canonical-alignment) ---
# Session token lifetime.
JWT_EXPIRES_IN=2h
# Shared key for worker / verifier endpoints (x-internal-api-key). Required for /consents/{id}/verify by a service and
# /internal/*; leave empty to disable service access (a SUPER_ADMIN token still works). Use a long random value.
INTERNAL_API_KEY=
# Identity adapter. "dev" keeps OTP in memory and bcrypt credentials in schema dev_identity (never in production).
IDENTITY_PROVIDER=dev

# Keycloak service-account client. It needs direct password grants plus realm-management roles: manage-users,
# query-users and view-users. Leave blank while using the local dev provider.
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=santulan
KEYCLOAK_CLIENT_ID=santulan-backend
KEYCLOAK_CLIENT_SECRET=
# Governed configuration files (absent or empty = the feature fails closed; no placeholder legal text ships).
CONSENT_PROTOCOLS_PATH=
QUALITY_POLICY_PATH=
EVIDENCE_CONFIG_PATH=
# Directory for research export files (protected storage). Empty = backend/exports (git-ignored).
EXPORT_DIR=
# Server inactivity timeout for assessment sessions. UNSET = disabled (the duration is an unfrozen decision).
SESSION_INACTIVITY_MINUTES=
# Registration throttling per IP and per device cookie (separate from OTP limits).
REGISTRATION_THROTTLE_WINDOW_SECONDS=3600
REGISTRATION_THROTTLE_MAX_PER_IP=20
REGISTRATION_THROTTLE_MAX_PER_DEVICE=10
# Failed password-login throttling per IP and entered Santulan ID/email. Single-process pilot only; no Redis required.
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_MAX_PER_IP=30
LOGIN_THROTTLE_MAX_PER_SUBJECT=5
# Governed scoring version label stamped on score rows (ASSUMED default; change only through governance).
SCORING_VERSION=domain-mean-v1
# "on" starts the worker that quality-checks and scores SUBMITTED attempts; anything else leaves it off.
SCORING_PIPELINE=

# --- BUILD 07 reporting / growth / pathways ---
# Governed report version label (ASSUMED default; change only through governance).
REPORT_VERSION=report-v3.1
# "on" starts the worker that builds reports for SCORED / QUALITY_HOLD / INVALID attempts; anything else leaves it off.
REPORT_WORKER=
# "on" starts the research export worker (generates requested exports into EXPORT_DIR).
EXPORT_WORKER=
# Research-stage growth-priority ranking weights (see config/growth-ranking.example.json). Empty = neutral domain order.
GROWTH_RANKING_PATH=
# Local pathway/support policy version recorded on each pathway decision (governance input).
PATHWAY_POLICY_VERSION=policy-unconfigured

# --- MongoDB (feature 006) - the dedicated local instance on port 27018 (never the service on 27017) ---
# Written by `npm run db:local:init` (printed once). Put the real values in the git-ignored backend/.env.
# Runtime user: least privilege (no remove, no schema changes). The only URI the API reads.
MONGODB_URI_RUNTIME="mongodb://santulan_runtime:CHANGE_ME@127.0.0.1:27018/santulan?replicaSet=rs0&authSource=santulan"
# Migrator user: dbOwner on the Santulan databases. Read ONLY by scripts and tests; never set in the API environment.
MONGODB_URI_ADMIN=
MONGODB_DB=santulan
# Scratch database for tests (name must contain test, qual or scratch).
MONGODB_TEST_DB=santulan_qual
