# Copy this file to .env at the REPO ROOT (docker compose loads .env from the directory holding docker-compose.yml,
# which is the repo root). Never commit the real .env - it's already gitignored.

# Passwords for the two MongoDB users the Docker mongo image creates on first run (mongo/bootstrap.js).
# Change these to real random values before running anything you care about.
SANTULAN_MIGRATOR_PASSWORD=change-me-migrator
SANTULAN_RUNTIME_PASSWORD=change-me-runtime

# Local Keycloak administrator account for pilot setup. Use unique, long values in the real .env file.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_PORT=8081

# Signs session tokens. Must be changed for anything beyond a throwaway local run.
JWT_SECRET=change-me-in-production

# Shared key for trusted internal workers/verifiers. Generate a long random value for a pilot deployment.
INTERNAL_API_KEY=

# Comma-separated browser origins allowed to call the API (CORS). Matches the frontend container's published port.
CORS_ORIGINS=http://localhost:3000

# Baked into the frontend image at BUILD time (CRA bakes env vars into the bundle) - the URL the browser uses to
# reach the backend container. The default assumes you're running everything on localhost with the ports below.
REACT_APP_API_BASE=http://localhost:8000/api/v1

# Host ports published by Docker Compose. Change these when local development already uses 8000/3000.
BACKEND_PORT=8000
FRONTEND_PORT=3000
# MongoDB stays bound to localhost, never the public network.
MONGODB_PORT=27018

# development | test | production - see backend/src/config for what each changes.
BACKEND_APP_ENV=development

# The built-in `dev` provider is for local development only and the backend refuses it when BACKEND_APP_ENV=production.
# A production value is valid only after a managed identity-provider adapter has been implemented in backend/src/services/identity.
IDENTITY_PROVIDER=dev

# Used by the Keycloak adapter once it is enabled. Keep the backend on IDENTITY_PROVIDER=dev until then.
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=santulan
KEYCLOAK_CLIENT_ID=santulan-backend
KEYCLOAK_CLIENT_SECRET=

# Consent protocol registry. For a production deployment, use:
# /app/config/consent-protocols.production.json
CONSENT_PROTOCOLS_PATH=

# Workers remain off unless explicitly enabled. Turn each on only after its governed prerequisites are in place.
SCORING_PIPELINE=
REPORT_WORKER=
EXPORT_WORKER=

# Optional Gmail API settings for real OPEN-participant password-reset emails. Leave blank for local development.
MAIL_ID=
CLIENT_ID=
CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
